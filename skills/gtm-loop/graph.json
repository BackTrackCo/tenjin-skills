    "take me off"
  ],
  "footer": {
    "lines": [
      "{senderName}, {senderCompany}",
      "{postalAddress}",
      "I found you through {source}. This is a one-time note about {offerName}.",
      "Reply stop and I will not write again."
    ],
    "notice": "Where I got your details: {dataSource}. To object, or to ask me to delete them, reply to this email."
  },
  "needs": {
    "x_posts": {
      "text": "Search recent public X posts for: {query}. Return each post's URL, text, author handle and date. Posts since {since}.",
      "fields": [
        "query",
        "since"
      ]
    },
    "reddit_posts": {
      "text": "Search public Reddit posts for: {query}. Only in these subreddits: {subreddits}. Most relevant first, posts since {since}. Return each post's URL, text, author and date.",
      "fields": [
        "query",
        "since",
        "subreddits"
      ]
    },
    "linkedin_posts": {
      "text": "Search recent public LinkedIn posts for the keywords: {query}. Return each post's URL, text, author and date. Posts since {since}.",
      "fields": [
        "query",
        "since"
      ]
    },
    "web_research": {
      "text": "Search the web for the page described here: {query} Return each page's URL, title, a short text and its date.",
      "fields": [
        "query"
      ]
    },
    "x_profile": {
      "text": "Read the public X profile of the handle {handle}. Return the name, bio, location and links.",
      "fields": [
        "handle"
      ]
    },
    "x_timeline": {
      "text": "Read the recent public X posts of the handle {handle}. Return each post's URL, text and date.",
      "fields": [
        "handle"
      ]
    },
    "linkedin_profile": {
      "text": "Read the public LinkedIn profile at {url}. Return the name, headline, location, about text and current company.",
      "fields": [
        "url"
      ]
    },
    "linkedin_author_posts": {
      "text": "Read the recent public LinkedIn posts of the profile at {url}. Return each post's URL, text and date.",
      "fields": [
        "url"
      ]
    },
    "company_list": {
      "text": "List companies in the industry {industry}, with size {size}, in {place}. Return each company's name and domain.",
      "fields": [
        "industry",
        "size",
        "place"
      ]
    },
    "company_profile": {
      "text": "Look up the company profile for the domain {domain}. Return the name, domain, LinkedIn page, size and country.",
      "fields": [
        "domain"
      ]
    },
    "people_search": {
      "text": "Find people with the role {role} at the company with the domain {domain}. Return each person's name, title, profile link and country.",
      "fields": [
        "role",
        "domain"
      ]
    },
    "person_enrichment": {
      "text": "Find the work email of {name} at the company with the domain {domain}. Return the address and its status.",
      "fields": [
        "name",
        "domain"
      ]
    },
    "email_check": {
      "text": "Check whether the email address {email} is deliverable. Return its status.",
      "fields": [
        "email"
      ]
    }
  },
  "prices": {
    "checkedAt": "2026-11-26",
    "note": "The catalog's provider price plus the 15% routing fee, upper end, in cents per call.",
