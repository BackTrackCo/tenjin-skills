{
  "name": "gtm-loop",
  "schemaVersion": 1,
  "neverHosts": [
    "x.com",
    "twitter.com",
    "linkedin.com",
    "reddit.com",
    "redd.it"
  ],
  "openHosts": [
    "x.com",
    "twitter.com",
    "linkedin.com",
    "reddit.com",
    "news.ycombinator.com"
  ],
  "fetchHosts": [
    "hn.algolia.com",
    "api.github.com"
  ],
  "statuses": [
    "new",
    "reviewed",
    "drafted",
    "picked",
    "approved",
    "contacted",
    "replied",
    "skipped",
    "suppressed",
    "stopped"
  ],
  "transitions": {
    "new": [
      "reviewed",
      "skipped",
      "suppressed",
      "stopped"
    ],
    "reviewed": [
      "drafted",
      "skipped",
      "suppressed",
      "stopped"
    ],
    "drafted": [
      "picked",
      "skipped",
      "suppressed",
      "reviewed"
    ],
    "picked": [
      "approved",
      "contacted",
      "drafted",
      "skipped",
      "suppressed"
    ],
    "approved": [
      "contacted",
      "picked",
      "skipped",
      "suppressed"
    ],
    "contacted": [
      "replied",
      "suppressed"
    ],
    "replied": [
      "suppressed"
    ],
    "stopped": [
      "reviewed",
      "skipped",
      "suppressed"
    ],
    "skipped": [],
    "suppressed": []
  },
  "terminal": [
    "skipped",
    "suppressed",
    "replied"
  ],
  "ops": [
    "rank",
    "transition",
    "draft",
    "signal",
    "warn"
  ],
  "channels": {
    "x_reply": {
      "platform": "x",
      "max": 280
    },
    "x_dm": {
      "platform": "x",
      "max": 280
    },
    "reddit_comment": {
      "platform": "reddit",
      "max": 600
    },
    "linkedin_comment": {
      "platform": "linkedin",
      "max": 600
    },
    "linkedin_note": {
      "platform": "linkedin",
      "max": 300
    },
    "hn_reply": {
      "platform": "hn",
      "max": 600
    },
    "email": {
      "platform": "email",
      "maxWords": 120,
      "subjectMax": 100
    },
    "web_reply": {
      "platform": "web",
      "max": 600
    }
  },
  "ruleEffects": [
    "min_score",
    "follow_up",
    "exclude_term",
    "exclude_domain",
    "exclude_person",
    "leads_per_round",
    "emails_per_day",
    "searches_per_day",
    "companies_per_search",
    "phrases_per_round",
    "rounds_per_day",
    "notify_off",
    "note",
    "searches_per_round"
  ],
  "capEffects": [
    "leads_per_round",
    "emails_per_day",
    "searches_per_day",
    "companies_per_search",
    "phrases_per_round",
    "rounds_per_day",
    "searches_per_round"
  ],
  "hashExcluded": [
    "note",
    "notify_off",
    "leads_per_round",
    "emails_per_day",
    "searches_per_day",
    "companies_per_search",
    "phrases_per_round",
    "rounds_per_day",
    "searches_per_round"
  ],
  "sweep": {
    "defaultHour": 7,
    "maxDaysBack": 14
  },
  "reviewBatch": 25,
  "followUp": {
    "defaultDays": 4
  },
  "workReasons": [
    "search_due",
    "review_due",
    "write_due",
    "approve_due",
    "email_due",
    "replies_due",
    "follow_up_due",
